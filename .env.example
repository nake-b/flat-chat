POSTGRES_USER=flat_chat
POSTGRES_PASSWORD=flat_chat
POSTGRES_DB=flat_chat
DATABASE_URL=postgresql://flat_chat:flat_chat@postgres:5432/flat_chat

# --- Host-only (you, if you're the one hosting the shared tailnet DB) -------
# Uncomment to load the tailscale sidecar overlay on top of the base stack.
# Teammates leave these unset — their `docker compose up` brings up just the
# local stack without any tailnet device, and they refresh data with
# ./scripts/refresh-db.sh.
# COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml
# TS_AUTHKEY=tskey-auth-<your-key>   # https://login.tailscale.com/admin/settings/keys (tag:flat-chat-db, reusable, non-ephemeral)

# --- Production deployment (Cloudflare Tunnel; the deploy host only) ---------
# Public access is via a Cloudflare Tunnel: cloudflared makes an OUTBOUND
# connection to Cloudflare's edge (no port-forwarding, works behind NAT/VPN),
# and Cloudflare terminates HTTPS. Create a tunnel at Cloudflare Zero Trust >
# Networks > Tunnels and paste its token here; map its public hostname to
# `http://nginx:80`. The prod stack is launched by scripts/deploy.sh, which sets
#   COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml:docker-compose.prod.yml
# For a public host also set, below: COOKIE_SECURE handled by the prod overlay,
# a fresh JWT_SECRET, and a strong DEV_USER_PASSWORD (the seed upserts it).
# CLOUDFLARE_TUNNEL_TOKEN=<tunnel-token>

# --- LLM — OpenAI (standard, non-Azure; PREFERRED when set) -----------------
# Preference order is OpenAI > Anthropic > Azure — set OPENAI_API_KEY and it
# takes over. OPENAI_MODEL defaults to gpt-5.4 (production agentic flagship);
# OPENAI_TITLE_MODEL is the cheap one-shot titling model. OPENAI_BASE_URL is
# optional (OpenAI-compatible proxies).
OPENAI_API_KEY=<your-key>
OPENAI_MODEL=gpt-5.4
OPENAI_TITLE_MODEL=gpt-5.4-nano
OPENAI_BASE_URL=

# --- LLM — Anthropic-direct (enables prompt caching) ------------------------
# ANTHROPIC_MODEL defaults to claude-sonnet-4-6.
# ANTHROPIC_TITLE_MODEL is the cheap one-shot model that summarises the first
# turn into a sidebar title (defaults to Haiku — fast, ~50 tokens per call).
ANTHROPIC_API_KEY=<your-key>
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TITLE_MODEL=claude-haiku-4-5-20251001

# --- LLM — Azure OpenAI (classic Azure OpenAI Service) ----------------------
# DEPLOYMENT is the name you typed when creating the deployment in Foundry.
# API_VERSION must be a preview version for o-series reasoning models.
# TITLE_DEPLOYMENT is optional — falls back to AZURE_OPENAI_DEPLOYMENT.
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=o4-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_TITLE_DEPLOYMENT=

# --- LLM usage budget (per-user cost guard) ---------------------------------
# Rolling-24h cap on total_tokens (input + output) summed across a user's chat
# runs, keyed on the authenticated user. A caller over budget is rejected with
# 429 BEFORE any tokens are spent. 0 DISABLES the per-user gate (a per-run
# runaway backstop still applies regardless). Lower it to cap cost per user.
LLM_DAILY_TOKEN_BUDGET=2000000

# --- Jina Embeddings (optional — leave empty to disable semantic search) ----
JINA_API_KEY=<your-key>
JINA_BASE_URL=https://api.jina.ai/v1

# --- Geocoding fallback (silver step; fills missing listing coordinates) -----
# Open address→coordinate API used to backfill listings that arrive without a
# scraped point (e.g. wohninberlin). Defaults to the public Nominatim instance
# (no key; ≤1 req/s; requires an identifying User-Agent). Point the base URL at
# a self-hosted Nominatim / Photon for bulk backfills.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=flat-chat-geocoder/1.0 (+https://github.com/nake-b/flat-chat)
GEOCODER_RATE_LIMIT_S=1.0

# --- Silver freshness cutoff (drops stale "old flat" listings) ---------------
# Listings scraped before this ISO date are treated as stale (gone from the
# market) and excluded from the listings table on EVERY silver run — skipped in
# transform AND pruned if already present. Bronze (raw_listings) is kept intact
# as the archive. Advance this date to drop an older batch permanently.
SILVER_MIN_SCRAPED_AT=2026-06-01

# --- Observability (dev only; Phoenix UI at http://localhost:6006) ----------
PHOENIX_ENABLED=true
PHOENIX_ENDPOINT=http://phoenix:6006/v1/traces

# --- Logging ----------------------------------------------------------------
# Backend log level for the `flat_chat` namespace. Third-party loggers
# stay at WARNING regardless. DEBUG / INFO / WARNING / ERROR / CRITICAL.
LOG_LEVEL=INFO

# --- Travel-time routing engines (the `routing` compose profile) -------------
# Internal OSRM (car) + MOTIS (transit) services. Defaults point at the compose
# service hostnames; override only to use external engines. Run
# scripts/prep-routing.sh once, then `docker compose --profile routing up`.
OSRM_URL=http://osrm:5000
MOTIS_URL=http://motis:8080
# --- Auth (fastapi-users) ---------------------------------------------------
# JWT_SECRET signs the login cookie and is REQUIRED (no insecure default ships).
# Left blank on purpose: the backend fails loudly on startup if it's unset, so a
# forgotten secret can't slip through as a placeholder. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it logs everyone out. JWT_LIFETIME_SECONDS defaults to 7 days.
JWT_SECRET=
JWT_LIFETIME_SECONDS=604800
# Cookie Secure attribute: false for local HTTP, true for any HTTPS deployment.
COOKIE_SECURE=false
# Accounts (created by `scripts/seed_users.py` — there is NO public
# signup). dev is an admin; the prof pair is optional (a reviewer login) and only
# seeded when both are set. Override in any deployment.
DEV_USER_EMAIL=dev@flatchat.dev
DEV_USER_PASSWORD=dev
PROF_USER_EMAIL=
PROF_USER_PASSWORD=
